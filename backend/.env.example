# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB
MONGO_URI=mongodb://localhost:27017/devops-copilot

# JWT
JWT_SECRET=replace-with-a-long-random-secret-min-32-chars
JWT_EXPIRES_IN=7d

# GitHub OAuth (for dashboard login)
GITHUB_CLIENT_ID=replace-with-github-oauth-app-client-id
GITHUB_CLIENT_SECRET=replace-with-github-oauth-app-client-secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# Ollama (local LLM — no API key needed)
OLLAMA_URL=http://localhost:11434
OLLAMA_RCA_MODEL=llama3
OLLAMA_PREDICT_MODEL=llama3
OLLAMA_EXPLAIN_MODEL=gemma:7b
OLLAMA_SLO_MODEL=llama3

# XGBoost AI Microservice (Python FastAPI)
AI_SERVICE_URL=http://localhost:8000

# Prometheus
PROMETHEUS_URL=http://localhost:9090

# Kubernetes
# Leave IN_CLUSTER=false for local dev with minikube/kind
IN_CLUSTER=false
K8S_DEFAULT_NAMESPACE=default
# KUBECONFIG=/path/to/.kube/config   # override if needed
